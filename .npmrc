# The tests/hosts/* workspaces pin @deepseek-ai/cordis@4.0.3 while
# @deepseek-ai/dsh-app-boot@0.1.7-rc.2 requires peer ~4.0.4. pnpm runs a bare
# `npm install` when this repository is installed as a git dependency, and that
# path cannot pass --legacy-peer-deps on the command line.
legacy-peer-deps=true
