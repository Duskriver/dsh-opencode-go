{
  "name": "dsh-opencode-go",
  "version": "0.3.0",
  "description": "OpenCode Go model provider and settings UI for DeepSeek Harness",
  "icon": "assets/icon.png",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duskriver/dsh-opencode-go.git"
  },
  "homepage": "https://github.com/Duskriver/dsh-opencode-go#readme",
  "bugs": {
    "url": "https://github.com/Duskriver/dsh-opencode-go/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/icon.png",
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples",
    "scripts/licenses",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "check:pack": "node scripts/check-pack.mjs",
    "check:install:pnpm": "node scripts/check-pnpm-install.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:hygiene": "node scripts/check-source.mjs",
    "test": "vitest run",
    "test:ci": "npm run check:dist && npm test",
    "prepack": "npm run check:dist",
    "prepublishOnly": "npm run typecheck && npm run test:ci",
    "verify:installed": "node --expose-internals scripts/installed-smoke.mjs",
    "verify:headless": "node scripts/headless-smoke.mjs",
    "verify": "npm run typecheck && npm run check:hygiene && npm run test:ci && npm run verify:installed"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.5",
