{
  "name": "dsh-opencode-go",
  "version": "0.1.14",
  "description": "OpenCode Go model provider and settings UI for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duskriver/dsh-opencode-go.git"
  },
  "homepage": "https://github.com/Duskriver/dsh-opencode-go#readme",
  "bugs": {
    "url": "https://github.com/Duskriver/dsh-opencode-go/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "verify:installed": "node --expose-internals scripts/installed-smoke.mjs",
    "verify:headless": "node scripts/headless-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
